{
  "redirects": [
    {
      "source": "/laundromats",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "https://api.getworkbuddy.com/admin/:path*" },
    { "source": "/report/:slug*", "destination": "https://api.getworkbuddy.com/report/:slug*" },
    { "source": "/offer/:slug*", "destination": "https://api.getworkbuddy.com/offer/:slug*" },
    { "source": "/connect/:slug", "destination": "https://api.getworkbuddy.com/connect/:slug" },
    { "source": "/portal/:path*", "destination": "https://api.getworkbuddy.com/portal/:path*" },
    { "source": "/portal", "destination": "https://api.getworkbuddy.com/portal" },
    { "source": "/welcome", "destination": "https://api.getworkbuddy.com/welcome" },
    { "source": "/welcome/:slug", "destination": "https://api.getworkbuddy.com/welcome/:slug" },
    { "source": "/dashboard/:slug", "destination": "https://api.getworkbuddy.com/dashboard/:slug" },
    { "source": "/preview/:slug", "destination": "https://api.getworkbuddy.com/preview/:slug" },
    { "source": "/start/:slug*", "destination": "https://api.getworkbuddy.com/start/:slug*" },
    { "source": "/confirm/:slug*", "destination": "https://api.getworkbuddy.com/confirm/:slug*" },
    { "source": "/unsubscribe", "destination": "https://api.getworkbuddy.com/unsubscribe" },
    { "source": "/api/:path*", "destination": "https://api.getworkbuddy.com/api/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://api.getworkbuddy.com/webhooks/:path*" },
    { "source": "/report-assets/:path*", "destination": "https://api.getworkbuddy.com/report-assets/:path*" },
    { "source": "/offer-assets/:path*", "destination": "https://api.getworkbuddy.com/offer-assets/:path*" },
    { "source": "/dashboard-assets/:path*", "destination": "https://api.getworkbuddy.com/dashboard-assets/:path*" },
    { "source": "/portal-assets/:path*", "destination": "https://api.getworkbuddy.com/portal-assets/:path*" },
    { "source": "/preview-assets/:path*", "destination": "https://api.getworkbuddy.com/preview-assets/:path*" },
    { "source": "/start-assets/:path*", "destination": "https://api.getworkbuddy.com/start-assets/:path*" },
    { "source": "/confirm-assets/:path*", "destination": "https://api.getworkbuddy.com/confirm-assets/:path*" },
    { "source": "/public/:path*", "destination": "https://api.getworkbuddy.com/public/:path*" },
    { "source": "/oauth/:path*", "destination": "https://api.getworkbuddy.com/oauth/:path*" },
    { "source": "/s/:slug", "destination": "/api/s/:slug" },
    { "source": "/sitemap-business.xml", "destination": "/api/sitemap-business.xml" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/property-management", "destination": "/index.html" },
    { "source": "/bella", "destination": "/index.html" },
    { "source": "/secret-shop", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/laundromat-ads", "destination": "/index.html" },
    { "source": "/laundromat-ads-short", "destination": "/index.html" },
    { "source": "/laundromat-ads/thank-you", "destination": "/index.html" },
    { "source": "/laundromats/thank-you", "destination": "/index.html" },
    { "source": "/free-makeover", "destination": "/index.html" },
    { "source": "/free-audit", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/s/:slug*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://getworkbuddy.com https://api.getworkbuddy.com" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "trailingSlash": false
}
